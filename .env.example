# Barbers.ph — single Firebase project `mybarberph`, two Firestore databases.
# Copy to .env.local for local development (use the DEV database).

NEXT_PUBLIC_DATA_SOURCE=firebase

# Web app (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mybarberph.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mybarberph
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Named databases in the SAME project:
#   barbersdb-dev  → local / App Hosting backend barbers-ph-dev
#   barbersdb      → production / App Hosting backend barbers-ph
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=barbersdb-dev
FIRESTORE_DATABASE_ID=barbersdb-dev
BARBERS_ENV=dev

# Optional: enable Google sign-in button once an OAuth client is configured in the console
# NEXT_PUBLIC_FIREBASE_GOOGLE_ENABLED=true

# Server-only. Prefer Application Default Credentials on App Hosting.
# Locally you can point at a user ADC (never commit it): see README.
# GOOGLE_APPLICATION_CREDENTIALS=.secret.user-adc.json
SESSION_COOKIE_NAME=bp_session

# SMS (Brevo transactional). Without these, sends are logged as queued/failed.
# BARBERS_SMS_ENABLED=true
# BREVO_SMS_API_KEY=
# BREVO_API_KEY=
# BREVO_SMS_SENDER=BarbersPH
