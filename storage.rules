rules_version = '2';

// Bucket mybarberph-shop-photos. Shop photos and logos are public (shown on the booking page and in
// River Mobile). The app uploads only through /api/shop/photos (Admin SDK: owner auth, JPEG/PNG/WebP,
// max 5 MB), so direct client writes are closed (river-ai-rules 03-build/integrations).
service firebase.storage {
  match /b/{bucket}/o {
    match /shops/{shopId}/photos/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
