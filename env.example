# Barbers.ph — environment variables (names + purpose only; never put real secrets here).
# Copy to .env.local for local runs (.env* files are git-ignored and excluded from App Hosting uploads).
# Named env.example (not .env.example) because this repo never commits .env* files; the rulebook calls it .env.example.
# Hosted values live in apphosting.yaml (shared), apphosting.dev.yaml (DEV) and apphosting.prod.yaml (PROD).
# Full matrix: docs/environments.md

# --- Firebase web config (public; inlined into the browser bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=            # Firebase web API key (public identifier, not a secret)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=        # e.g. mybarberph.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=         # mybarberph
NEXT_PUBLIC_FIREBASE_APP_ID=             # Firebase web app id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID= # Firebase sender id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=     # Shop photo bucket (mybarberph-shop-photos)
NEXT_PUBLIC_MAP_STYLE_URL=               # MapLibre style JSON (River Maps)
NEXT_PUBLIC_AUTH_SAME_ORIGIN=            # "1" = use the host's /__/auth/handler for Google sign-in (hosted.app / web.app only)

# --- Database selection (server + browser label) ---
FIRESTORE_DATABASE_ID=barbersdb-dev      # Admin SDK database. DEV = barbersdb-dev, PROD = barbersdb. Local runs: keep DEV.
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=barbersdb-dev # Same value, readable in the browser (display/diagnostics only)
FIREBASE_STORAGE_BUCKET=                 # Optional server override for the photo bucket
GCLOUD_PROJECT=                          # Optional project override for the Admin SDK (defaults to mybarberph)

# --- Environment + flags ---
BARBERS_ENV=dev                          # "dev" | "prod". Non-prod robots.txt blocks crawling.
NEXT_PUBLIC_AUTH_TEST_MODE=0             # "1" lets a browser opted in via localStorage bp.authTest=1 use Firebase test phone numbers without reCAPTCHA. Default off.
COMPANION_ENABLED=0                      # "1" shows the AI Companion (DEV only today). Copied to NEXT_PUBLIC_COMPANION_ENABLED at build.
COMPANION_MODEL=                         # Optional Gemini model (default gemini-2.5-flash)
COMPANION_LOCATION=                      # Optional Vertex AI region (default asia-southeast1)
PLAN_LIMITS_ENABLED=0                    # "1" enforces plan limits (walk-in cap, QR, shops, questions). Copied to NEXT_PUBLIC_PLAN_LIMITS_ENABLED.
SESSION_COOKIE_NAME=                     # Set in apphosting.yaml (bp_session) but not read by the app today (reserved).

# --- Secrets (App Hosting secrets in hosted envs; never commit values) ---
GITHUB_SUBMODULE_TOKEN=                 # Build-only GitHub PAT (Contents: Read) for the private kit and maps submodules. App Hosting secret. Local builds use the git checkout instead.
COMPANION_CRON_SECRET=                   # Bearer secret for the Monday tips runner (POST /api/companion/tips)
BREVO_API_KEY=                           # Brevo transactional SMS + email for new online bookings
RIVER_MOBILE_API_KEY=                    # x-api-key for the River Mobile partner API (/api/river/v1/*); unset = 503
PAYMONGO_SECRET_KEY=                     # PayMongo secret key for plan checkout (PAYMONGO_SECRET is a legacy alias)
PAYMONGO_WEBHOOK_SECRET=                 # PayMongo webhook signing secret (/api/billing/webhook); unset = 503
NOTIFY_SMS_WEBHOOK_URL=                  # Optional SMS relay: POST {to, text}
NOTIFY_EMAIL_WEBHOOK_URL=                # Optional email relay: POST {to, subject, text}
NOTIFY_WEBHOOK_TOKEN=                    # Optional bearer token for both relays
