rules_version = '2';

// Barbers.ph Firestore rules. Deployed to both named databases: barbersdb-dev and barbersdb.
//
// The web app reads and writes through its own server (Admin SDK, which bypasses these rules).
// The browser never uses the Firestore SDK (only Firebase Auth), so no client may write business data
// (river-ai-rules 00-core §1). These rules are the boundary for any direct client access:
//   * shops/{shopId}            shopId == the owner's Firebase Auth uid.
//                               Public read only when the shop is listed (profile, address, pin,
//                               photos, services: what River Mobile needs). Plan/billing fields are
//                               set by the server only, so clients can never write this document.
//   * shops/{shopId}/private/*  owner may read; writes are server-only.
//   * shops/{shopId}/bookings/* owner may read; writes are server-only (owner app, customers and
//                               River Mobile all go through the API).
//   * community_posts/*         readable by anyone, written by the server only.
//   * everything else           closed.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(shopId) { return signedIn() && request.auth.uid == shopId; }

    match /shops/{shopId} {
      allow read: if isOwner(shopId) || resource.data.listed == true;
      allow write: if false;

      match /private/{key} {
        allow read: if isOwner(shopId);
        allow write: if false;
      }

      // AI Companion: chat, goals, usage and quota (server writes; owner may read).
      match /companion/{doc=**} {
        allow read: if isOwner(shopId);
        allow write: if false;
      }
      // Weekly Companion tips and alerts.
      match /insights/{weekId} {
        allow read: if isOwner(shopId);
        allow write: if false;
      }

      match /bookings/{bookingId} {
        allow read: if isOwner(shopId);
        allow write: if false;
      }
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
