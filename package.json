{
  "name": "mybarberph",
  "version": "0.1.0",
  "private": true,
  "description": "Barbers.ph by River Apps: barbershop queue, sales record, kiosk and River Mobile partner app (front-end, sample data, Firebase-ready data layer).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "kit:build": "node scripts/kit-build.mjs",
    "dev": "npm run kit:build && next dev -p 3300",
    "build": "npm run kit:build && next build",
    "start": "next start -p 3300",
    "lint": "eslint .",
    "typecheck": "npm run kit:build && tsc --noEmit",
    "screenshots": "python3 scripts/screenshots.py"
  },
  "dependencies": {
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
