{
  "name": "mybarberph",
  "version": "1.0.18",
  "private": true,
  "description": "Barbers.ph by River Apps: barbershop queue, sales record, kiosk and River Mobile partner app (front-end, sample data, Firebase-ready data layer).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "kit:build": "node scripts/kit-build.mjs",
    "dev": "npm run kit:build && next dev -p 3300",
    "build": "npm run kit:build && next build",
    "start": "next start -p 3300",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "screenshots": "python3 scripts/screenshots.py",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/storage": "^8.4.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "jsqr": "^1.4.0",
    "lucide-react": "1.51.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.3.8",
    "pmtiles": "^4.5.0",
    "qrcode-generator": "^1.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
